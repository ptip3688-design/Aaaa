rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMode(mode) {
      return mode is string && mode in ['general', 'coding', 'writing', 'translate'];
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['auto', 'en', 'ur', 'roman-ur', 'hi'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'preferredLanguage',
          'voiceEnabled',
          'memoryNotes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'preferredLanguage',
          'voiceEnabled',
          'memoryNotes',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() <= 200
        && isValidLanguage(data.preferredLanguage)
        && data.voiceEnabled is bool
        && data.memoryNotes is string
        && data.memoryNotes.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'mode',
          'messageCount',
          'lastMessagePreview',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'mode',
          'messageCount',
          'lastMessagePreview',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && isValidMode(data.mode)
        && data.messageCount is int
        && data.messageCount >= 0
        && data.messageCount <= 10000
        && data.lastMessagePreview is string
        && data.lastMessagePreview.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
          'ownerId',
          'role',
          'content',
          'mode',
          'hasAttachment',
          'attachmentName',
          'attachmentType',
          'groundingLinks',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'role',
          'content',
          'mode',
          'hasAttachment',
          'attachmentName',
          'attachmentType',
          'groundingLinks',
          'createdAt'
        ])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.role is string
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 30000
        && isValidMode(data.mode)
        && data.hasAttachment is bool
        && data.attachmentName is string
        && data.attachmentName.size() <= 200
        && data.attachmentType is string
        && data.attachmentType.size() <= 100
        && data.groundingLinks is list
        && data.groundingLinks.size() <= 10
        && (data.groundingLinks.size() == 0 || (data.groundingLinks[0] is string && data.groundingLinks[0].size() <= 500))
        && data.createdAt is timestamp;
    }

    // Users collection (Strict PII isolation)
    match /users/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'preferredLanguage',
          'voiceEnabled',
          'memoryNotes',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow get: if isVerifiedUser()
        && isValidId(conversationId)
        && existing().ownerId == request.auth.uid;

      allow list: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(conversationId)
        && isValidConversation(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(conversationId)
        && existing().ownerId == request.auth.uid
        && isValidConversation(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['mode', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'lastMessagePreview', 'mode', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messageCount', 'lastMessagePreview', 'mode', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(conversationId)
        && existing().ownerId == request.auth.uid;

      // Messages subcollection (Master Gate + Query Enforcer)
      match /messages/{messageId} {
        allow get: if isVerifiedUser()
          && isValidId(conversationId)
          && isValidId(messageId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid;

        allow list: if isVerifiedUser()
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(conversationId)
          && isValidId(messageId)
          && isValidMessage(incoming())
          && incoming().createdAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid;

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(conversationId)
          && isValidId(messageId)
          && existing().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
